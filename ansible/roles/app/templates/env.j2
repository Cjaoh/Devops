# ===========================================================
# .env — Généré automatiquement par Ansible
# ===========================================================

# ── Base de données PostgreSQL ───────────────────────────
POSTGRES_HOST={{ db_host | default('db') }}
POSTGRES_PORT={{ db_port | default(5432) }}
POSTGRES_DB={{ db_name | default('reservations_db') }}
POSTGRES_USER={{ db_user | default('app_user') }}
POSTGRES_PASSWORD={{ db_password | default('lmscodeadmin') }}

# ── JWT ──────────────────────────────────────────────────
SECRET_KEY={{ jwt_secret_key | default('lmscodeadmin') }}
ALGORITHM={{ jwt_algorithm | default('HS256') }}
ACCESS_TOKEN_EXPIRE_MINUTES={{ jwt_expire_minutes | default(60) }}

# ── SMTP ─────────────────────────────────────────────────
SMTP_HOST={{ smtp_host | default('localhost') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') }}
SMTP_FROM={{ smtp_from | default('noreply@example.com') }}

# ── Application ──────────────────────────────────────────
APP_ENV={{ app_env | default('production') }}
APP_HOST=0.0.0.0
APP_PORT={{ app_port | default(8000) }}
